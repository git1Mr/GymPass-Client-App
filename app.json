{
  "expo": {
    "name": "UnityFitness",
    "slug": "unityfitness",
    "version": "1.0.0",
    "scheme": "unityfitness",
    "platforms": ["ios", "android"],
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        { "faceIDPermission": "Allow UnityFitness to use Face ID for secure login." }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "YOUR_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "ios": {
      "supportsTablet": true
    }
  }
}
