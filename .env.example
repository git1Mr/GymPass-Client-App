# --- Docker Compose env for UnityFitness backend ----------------------------
# Copy to .env and fill in real values. .env is git-ignored.

# Docker Hub namespace used to tag & push images (e.g. "zakarialem")
DOCKERHUB_USER=zakarialem

# Shared between auth-service (signs) and wallet-service (verifies)
JWT_PRIVATE_KEY=replace-with-a-long-random-string

# Mongo root user (used by all services to connect with authSource=admin)
MONGO_ROOT_USER=root
MONGO_ROOT_PASS=changeme

# Stripe (wallet-service only)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=mad
STRIPE_MERCHANT_NAME=UnityFitness

# --- Expo mobile client (read by services/api.ts) -----------------------------
# Default (works for Expo web + iOS simulator): http://localhost:8080/api
# Uncomment + edit ONE of these to override:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api          # Android emulator
# EXPO_PUBLIC_API_URL=http://192.168.X.Y:8080/api       # Physical phone on same Wi-Fi
# EXPO_PUBLIC_API_URL=https://YOUR.trycloudflare.com/api # Physical phone over the internet

# --- Expo Stripe (read by app/_layout.tsx → StripeProvider) -----------------
# Same publishable key as STRIPE_PUBLISHABLE_KEY above — duplicated because
# Expo only bundles vars with the EXPO_PUBLIC_ prefix.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.unityfitness
